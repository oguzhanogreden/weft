{
  "name": "@effect-ui/router",
  "version": "0.0.0",
  "description": "Universal nested router for effect-ui",
  "license": "MIT",
  "author": "Stef van Wijchen",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "dependencies": {
    "@effect-ui/core": "workspace:*",
    "@effect-ui/dom": "workspace:*",
    "@effect/platform": "catalog:",
    "@effect/rpc": "catalog:"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.1",
    "effect": "catalog:",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": "^3.21"
  }
}
