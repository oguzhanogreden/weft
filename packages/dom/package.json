		"typecheck": "tsc"
	},
	"dependencies": {
		"@effect-ui/core": "workspace:*",
		"@effect-ui/html-types": "workspace:*",
		"@effect-ui/jsx-runtime": "workspace:*",
		"@types/jsdom": "^28.0.3",
		"jsdom": "^29.1.1"
	},
	"devDependencies": {
		"@types/node": "^25.9.1",
		"effect": "^3.21.2",
		"tsdown": "^0.22.0",
		"tsx": "^4.22.3",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"effect": "^3.21"
	}
}