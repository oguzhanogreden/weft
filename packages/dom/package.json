{
	"name": "@effect-ui/dom",
	"version": "0.0.0",
	"description": "Client-side DOM renderer for effect-ui",
	"license": "MIT",
	"author": "Stef van Wijchen",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "tsdown",
		"test": "node --import tsx --test src/**/*.test.{ts,tsx}",
