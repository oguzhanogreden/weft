{
  "name": "@weftui/dom",
  "version": "0.0.0",
  "description": "Client-side DOM renderer for Weft",
  "license": "MIT",
  "author": "Stef van Wijchen",
  "repository": {
    "type": "git",
    "url": "https://github.com/stefvw93/weft"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@weftui/core": "workspace:*"
  },
  "devDependencies": {
    "@effect/rpc": "catalog:",
    "@types/jsdom": "^28.0.3",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "jsdom": "^29.1.1",
    "tsx": "catalog:",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": "^3.21"
  }
}
